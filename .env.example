# --- YouTube (free: console.cloud.google.com -> enable "YouTube Data API v3" -> API key) ---
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- YouTube Analytics (OAuth — owner-only momentum: subs gained per video, traffic) ---
# One-time setup in DEPLOY.md. Three values from the OAuth Playground or auth_youtube.py:
YT_OAUTH_CLIENT_ID=
YT_OAUTH_CLIENT_SECRET=
YT_OAUTH_REFRESH_TOKEN=

# --- Instagram (Business/Creator account + Meta app -> long-lived token) ---
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- BeatStars (no API — just your public page) ---
BEATSTARS_URL=https://beatstars.com/prodkpc

DB_PATH=data/growth.db

# --- Cloudflare R2 (video storage) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
R2_BUCKET=prodkpc-videos
R2_PUBLIC_BASE=https://pub-95e446d1e0e34fabab097243229d313d.r2.dev
